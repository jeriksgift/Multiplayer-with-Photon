.game-hud {
    flex-grow: 1;
    padding: 32px 40px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&guid=287a5872154fc5043a8cb796be0c4cc2&type=3#Mono");
}
.game-hud .unity-label { color: rgb(255, 255, 255); margin: 0; padding: 0; }
.hud-top, .hud-bottom { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.hud-top { flex-grow: 1; }
.room-info { width: 360px; padding: 16px 20px; background-color: rgb(18, 18, 18); border-radius: 12px; }
.room-name { font-size: 22px; overflow: hidden; text-overflow: ellipsis; -unity-font-style: bold; }
.hud-caption { font-size: 22px; -unity-font-style: bold; -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Body.ttf"); }
.hud-panel, .hud-menu {
    background-color: rgb(18, 18, 18);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    border-top-left-radius: 30px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 12px;
}
.score-area { position: absolute; left: 0; right: 0; align-items: center; }
.score-panel { width: 560px; height: 128px; flex-direction: row; align-items: center; justify-content: space-between; padding: 12px 28px; }
.team-score { width: 94px; align-items: center; }
.blue-score { border-bottom-width: 4px; border-bottom-color: rgb(95, 170, 255); }
.red-score { border-bottom-width: 4px; border-bottom-color: rgb(255, 110, 110); }
.score-value { font-size: 42px; -unity-font-style: bold; }
.timer-group { align-items: center; }
.timer-value { font-size: 36px; -unity-font-style: bold; }
.hud-menu { margin: 0; padding: 12px 24px; font-size: 22px; color: rgb(255, 255, 255); }
.hud-menu:hover, .hud-menu:focus { background-color: rgb(54, 54, 49); }
.hud-bottom { align-items: flex-end; }
.health-panel { position: absolute; left: 50%; bottom: 0; margin-left: -140px; width: 280px; padding: 16px 24px 22px 24px; }
.health-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.health-value { font-size: 40px; -unity-font-style: bold; }
.health-track { height: 6px; background-color: rgb(65, 65, 62); }
.health-fill { height: 100%; width: 100%; background-color: rgb(255, 255, 255); }
.ammo-panel { margin-left: auto; margin-bottom: 100px; width: 256px; padding: 16px 24px; }
.match-settings-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ammo-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.ammo-reserve { font-size: 20px; -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Body.ttf"); -unity-font-style: bold; }
.ammo-value { font-size: 42px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 8px; }
.game-hud .ammo-empty { color: rgb(204, 150, 142); }
.crosshair { position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin-left: -12px; margin-top: -12px; }
.crosshair-outline-horizontal { position: absolute; left: 0; top: 9px; width: 24px; height: 6px; background-color: rgb(0, 0, 0); }
.crosshair-outline-vertical { position: absolute; left: 9px; top: 0; width: 6px; height: 24px; background-color: rgb(0, 0, 0); }
.crosshair-horizontal { position: absolute; left: 2px; top: 11px; width: 20px; height: 2px; background-color: rgb(255, 255, 255); }
.crosshair-vertical { position: absolute; left: 11px; top: 2px; width: 2px; height: 20px; background-color: rgb(255, 255, 255); }
.respawn-status { position: absolute; top: 58%; align-self: center; padding: 10px 22px; background-color: rgb(18, 18, 18); border-radius: 10px; font-size: 32px; -unity-font-style: bold; -unity-text-align: middle-center; }
.hud-hidden { display: none; }
.mobile-controls { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.look-area { position: absolute; left: 50%; right: 0; top: 0; bottom: 0; }
.touch-control { position: absolute; width: 130px; height: 130px; border-radius: 65px; border-width: 3px; border-color: rgba(255,255,255,.75); background-color: rgba(18,18,18,.65); align-items: center; justify-content: center; }
.touch-control .unity-label { font-size: 22px; -unity-font-style: bold; }
.touch-joystick { left: 5%; bottom: 7%; width: 220px; height: 220px; border-radius: 110px; }
.joystick-knob { position: absolute; left: 50%; top: 50%; width: 76px; height: 76px; margin-left: -38px; margin-top: -38px; border-radius: 38px; background-color: rgba(255,255,255,.65); }
.touch-sprint { left: 8%; bottom: 34%; }
.touch-jump { right: 5%; bottom: 34%; }
.touch-fire { right: 17%; bottom: 19%; width: 160px; height: 160px; border-radius: 80px; }
.scoreboard-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,.85); justify-content: center; align-items: center; }
.scoreboard-card { width: 960px; max-width: 90%; max-height: 85%; padding: 28px; }
.scoreboard-title { font-size: 34px; }
.scoreboard-heading { font-size: 25px; margin-top: 24px; margin-bottom: 12px; }
.scoreboard-row { flex-direction: row; padding: 12px; background-color: rgb(35,35,35); margin-bottom: 6px; font-size: 26px; }
.scoreboard-name { flex-grow: 1; overflow: hidden; text-overflow: ellipsis; }
.hud-icon-button { width: 84px; height: 84px; padding: 16px; align-items: center; justify-content: center; }
.hud-action-icon { width: 44px; height: 44px; }
.hud-small-icon { width: 28px; height: 28px; }
.control-icon { width: 48%; height: 48%; }
.score-target-row { flex-direction: row; align-items: center; }
.score-target-row .hud-small-icon { margin-right: 8px; width: 22px; height: 22px; }
.reload-active { -unity-background-image-tint-color: rgb(255, 196, 95); }
.icon-fire { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/fire.svg"); }
.icon-jump { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/jump.svg"); }
.icon-sprint { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/sprint.svg"); }
.icon-settings { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/settings.svg"); }
.icon-leave { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/leave.svg"); }
.icon-health { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/health.svg"); }
.icon-ammo { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/ammo.svg"); }
.icon-reload { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/reload.svg"); }
.icon-close { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/close.svg"); }
.icon-target { background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/target.svg"); }
