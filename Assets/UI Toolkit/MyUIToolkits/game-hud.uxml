<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="game-hud.uss"/>
    <ui:VisualElement name="GameHud" class="game-hud" picking-mode="Ignore">
        <ui:VisualElement class="hud-top">
            <ui:VisualElement class="room-info"><ui:Label name="RoomName" text="Room" class="room-name"/><ui:Label name="LocalTeam" text="TEAM DEATHMATCH" class="hud-caption"/></ui:VisualElement>
            <ui:VisualElement class="score-area">
                <ui:VisualElement class="hud-panel score-panel">
                    <ui:VisualElement class="team-score blue-score"><ui:Label text="BLUE" class="hud-caption"/><ui:Label name="BlueScore" text="0" class="score-value"/></ui:VisualElement>
                    <ui:VisualElement class="timer-group"><ui:Label name="MatchTimer" text="20:00" class="timer-value"/><ui:Label name="ScoreTarget" text="FIRST TO 10" class="hud-caption"/></ui:VisualElement>
                    <ui:VisualElement class="team-score red-score"><ui:Label text="RED" class="hud-caption"/><ui:Label name="RedScore" text="0" class="score-value"/></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="MenuButton" text="Esc / Menu" class="hud-menu"/>
        </ui:VisualElement>
        <ui:VisualElement name="Crosshair" class="crosshair" picking-mode="Ignore"><ui:VisualElement class="crosshair-outline-horizontal"/><ui:VisualElement class="crosshair-outline-vertical"/><ui:VisualElement class="crosshair-horizontal"/><ui:VisualElement class="crosshair-vertical"/></ui:VisualElement>
        <ui:Label name="RespawnStatus" text="RESPAWNING" class="respawn-status hud-hidden"/>
        <ui:VisualElement class="hud-bottom">
            <ui:VisualElement class="hud-panel health-panel">
                <ui:VisualElement class="health-heading"><ui:Label text="HEALTH" class="hud-caption"/><ui:Label name="HealthValue" text="100" class="health-value"/></ui:VisualElement>
                <ui:VisualElement class="health-track"><ui:VisualElement name="HealthFill" class="health-fill"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-panel ammo-panel">
                <ui:Label text="AMMO / UNLIMITED RESERVE" class="hud-caption"/>
                <ui:Label name="AmmoValue" text="07 / 07" class="ammo-value"/>
                <ui:Label name="AmmoStatus" text="R / RELOAD" class="hud-caption"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
