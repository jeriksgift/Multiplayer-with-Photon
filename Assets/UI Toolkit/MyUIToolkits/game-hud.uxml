<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MatchSettings" src="Settings/settings.uxml" />
    <Style src="project://database/Assets/UI%20Toolkit/MyUIToolkits/game-hud.uss?fileID=7433441132597879392&amp;guid=be801e955e4e43945a16f9eb8a9b399a&amp;type=3#game-hud"/>
    <ui:VisualElement name="GameHud" picking-mode="Ignore" class="game-hud">
        <ui:VisualElement class="hud-top">
            <ui:VisualElement class="room-info">
                <ui:Label name="RoomName" text="Room" class="room-name"/>
                <ui:Label name="LocalTeam" text="" class="hud-hidden"/>
            </ui:VisualElement>
            <ui:VisualElement class="score-area">
                <ui:VisualElement name="ScoreArea" class="hud-panel score-panel">
                    <ui:VisualElement class="team-score blue-score">
                        <ui:Label name="BlueScore" text="0" class="score-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="timer-group">
                        <ui:Label name="MatchTimer" text="20:00" class="timer-value"/>
                        <ui:VisualElement class="score-target-row"><ui:VisualElement class="hud-small-icon icon-target" /><ui:Label name="ScoreTarget" text="10" class="hud-caption"/></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="team-score red-score">
                        <ui:Label name="RedScore" text="0" class="score-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="MenuButton" tooltip="Settings" class="hud-menu hud-icon-button"><ui:VisualElement picking-mode="Ignore" class="hud-action-icon icon-settings" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="Crosshair" picking-mode="Ignore" class="crosshair">
            <ui:VisualElement class="crosshair-outline-horizontal"/>
            <ui:VisualElement class="crosshair-outline-vertical"/>
            <ui:VisualElement class="crosshair-horizontal"/>
            <ui:VisualElement class="crosshair-vertical"/>
        </ui:VisualElement>
        <ui:Label name="RespawnStatus" text="RESPAWNING" class="respawn-status hud-hidden"/>
        <ui:VisualElement class="hud-bottom">
            <ui:Button name="LeaveMatchButton" tooltip="Leave match" class="hud-menu hud-icon-button leave-match"><ui:VisualElement picking-mode="Ignore" class="hud-action-icon icon-leave" /></ui:Button>
            <ui:VisualElement class="hud-panel health-panel">
                <ui:VisualElement class="health-heading">
                    <ui:VisualElement class="hud-small-icon icon-health" />
                    <ui:Label name="HealthValue" text="100" class="health-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="health-track">
                    <ui:VisualElement name="HealthFill" class="health-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AmmoArea" class="hud-panel ammo-panel">
                <ui:VisualElement class="ammo-heading">
                    <ui:VisualElement class="hud-small-icon icon-ammo" />
                    <ui:VisualElement name="ReloadIcon" class="hud-small-icon icon-reload" />
                </ui:VisualElement>
                <ui:Label name="AmmoValue" text="07 / ∞" class="ammo-value"/>
                <ui:Label name="AmmoStatus" text="" class="hud-hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ScoreboardOverlay" class="scoreboard-overlay hud-hidden">
            <ui:VisualElement class="hud-panel scoreboard-card">
                <ui:Label text="MATCH PLAYERS" class="scoreboard-title" />
                <ui:Button name="CloseScoreboard" tooltip="Close scoreboard" class="hud-menu hud-icon-button"><ui:VisualElement picking-mode="Ignore" class="hud-action-icon icon-close" /></ui:Button>
                <ui:ScrollView name="ScoreboardRows" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="MatchSettings" name="MatchSettingsHost" class="match-settings-host" />
    </ui:VisualElement>
</ui:UXML>
