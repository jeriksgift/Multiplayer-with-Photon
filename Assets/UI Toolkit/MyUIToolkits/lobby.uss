:root {
}

.my-input-fields {
    border-top-left-radius: 30px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 15px;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&guid=287a5872154fc5043a8cb796be0c4cc2&type=3#Mono");
    -unity-font-style: normal;
    font-size: 36px;
    color: rgb(0, 0, 0);
}

.lobby-status {
    width: 70%;
    white-space: normal;
    font-size: 20px;
    color: rgb(244, 171, 121);
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&guid=287a5872154fc5043a8cb796be0c4cc2&type=3#Mono");
}

.lobby-status--hidden {
    display: none;
}

.lobby-exit-button {
    position: absolute;
    top: 40px;
    right: 40px;
    height: 60px;
    padding: 0 32px;
    margin: 0;
    font-size: 28px;
    color: white;
    background-color: rgb(34, 34, 34);
    -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&guid=287a5872154fc5043a8cb796be0c4cc2&type=3#Mono");
    border-width: 3px;
    border-color: white;
    border-top-left-radius: 30px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 10px;
}

.lobby-exit-button:hover, .lobby-exit-button:focus { background-color: rgb(60, 60, 53); }
