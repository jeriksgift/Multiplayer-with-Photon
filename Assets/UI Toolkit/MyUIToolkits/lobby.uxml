    <Style src="project://database/Assets/UI%20Toolkit/MyUIToolkits/lobby.uss?fileID=7433441132597879392&amp;guid=705202ba43fa2714fb79a59449545dc7&amp;type=3#lobby"/>
    <ui:VisualElement name="Panel" style="flex-grow: 1; opacity: 1; background-color: rgba(0, 0, 0, 0.784); align-content: auto; align-items: auto; height: auto;">
        <ui:VisualElement name="Container" style="width: 40%; height: auto; background-color: rgba(30, 30, 30, 0.588); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-top: 50px; margin-right: 50px; margin-bottom: 50px; margin-left: 50px; border-top-left-radius: 50px; border-top-right-radius: 20px; border-bottom-right-radius: 50px; border-bottom-left-radius: 20px; align-items: center; justify-content: flex-start; align-self: flex-end; align-content: flex-start; right: 0; bottom: -27.5%; top: auto;">
            <ui:Label text="Enter the Arena" style="align-self: auto; background-color: rgba(255, 255, 255, 0); -unity-font-style: bold; font-size: 48px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&amp;guid=287a5872154fc5043a8cb796be0c4cc2&amp;type=3#Mono&quot;); -unity-text-align: upper-left; margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; align-items: auto; align-content: auto;"/>
