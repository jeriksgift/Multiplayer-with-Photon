.loading-screen {
    flex-grow: 1;
    background-color: rgb(18, 18, 18);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/ToysDeathMatch/Fonts/Mono.ttf?fileID=12800000&guid=287a5872154fc5043a8cb796be0c4cc2&type=3#Mono");
}

.loading-hidden { display: none; }

.loading-center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 80px;
}

.loading-status {
    font-size: 30px;
    margin: 0 0 28px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.loading-track {
    width: 340px;
    max-width: 100%;
    height: 2px;
    background-color: rgb(55, 55, 53);
    overflow: hidden;
}

.loading-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 22%;
    background-color: rgb(255, 255, 255);
}

.loading-progress {
    height: 28px;
    margin-top: 16px;
    font-size: 18px;
    color: rgb(255, 255, 255);
}

.loading-footer {
    position: absolute;
    left: 40px;
    bottom: 36px;
}

.loading-brand {
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin: 0;
}
