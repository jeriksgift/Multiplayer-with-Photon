<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="match-results.uss"/>
    <ui:VisualElement class="results-screen">
        <ui:VisualElement class="results-header">
            <ui:Label text="MATCH COMPLETE" class="results-eyebrow"/>
            <ui:Label name="ResultRoom" text="Toys Death Match" class="results-room"/>
        </ui:VisualElement>
        <ui:VisualElement class="results-content">
            <ui:Label name="WinnerTitle" text="Blue Team Wins!" class="results-title"/>
            <ui:Label name="ResultSubtitle" text="Match complete. Here's how everyone played." class="results-subtitle"/>
            <ui:ScrollView class="results-scroll" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="results-columns">
                    <ui:VisualElement name="BlueCard" class="result-card blue-card">
                        <ui:VisualElement class="score-heading">
                            <ui:VisualElement><ui:Label text="BLUE TEAM" class="team-title"/><ui:Label name="BlueStatus" text="WINNER" class="team-status"/></ui:VisualElement>
                            <ui:Label name="BlueFinalScore" text="00" class="final-score"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="table-header"><ui:Label text="PLAYER" class="player-name"/><ui:Label text="KILLS" class="stat-value"/><ui:Label text="DAMAGE" class="stat-value"/></ui:VisualElement>
                        <ui:VisualElement name="BluePlayers"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="RedCard" class="result-card red-card">
                        <ui:VisualElement class="score-heading">
                            <ui:VisualElement><ui:Label text="RED TEAM" class="team-title"/><ui:Label name="RedStatus" text="FINAL SCORE" class="team-status"/></ui:VisualElement>
                            <ui:Label name="RedFinalScore" text="00" class="final-score"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="table-header"><ui:Label text="PLAYER" class="player-name"/><ui:Label text="KILLS" class="stat-value"/><ui:Label text="DAMAGE" class="stat-value"/></ui:VisualElement>
                        <ui:VisualElement name="RedPlayers"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="results-footer">
            <ui:Label text="Toys Death Match" class="results-brand"/>
            <ui:Button name="ReturnToLobbyButton" text="Return to Lobby" class="return-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
