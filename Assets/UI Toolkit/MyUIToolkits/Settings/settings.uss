.settings-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.88); justify-content: center; align-items: center; padding: 40px; }
.settings-card { width: 1160px; max-width: 100%; height: 860px; max-height: 100%; background-color: rgb(18, 18, 18); border-width: 2px; border-color: rgb(100, 100, 100); }
.settings-close { margin-left: 20px; width: 76px; height: 70px; align-items: center; justify-content: center; padding: 12px; }
.settings-close-icon { width: 32px; height: 32px; background-image: url("project://database/Assets/UI Toolkit/MyUIToolkits/Icons/close.svg"); }
.settings-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.settings-tabs { width: 230px; margin-right: 32px; }
.settings-tab { -unity-text-align: middle-left; }
.settings-content { flex-grow: 1; min-width: 0; }
.settings-content .unity-scroll-view__content-container { padding-right: 20px; }
.settings-player-id { font-size: 24px; white-space: normal; margin-bottom: 16px; }
.settings-slider { margin: 18px 0 10px; height: 42px; }
.settings-slider > .unity-base-field__label { min-width: 130px; color: white; font-size: 28px; }
.settings-slider .unity-base-slider__tracker { background-color: rgb(90, 90, 90); height: 5px; }
.settings-slider .unity-base-slider__dragger { background-color: white; border-color: white; width: 24px; height: 24px; margin-top: -10px; border-radius: 12px; }
#ControlsPage .settings-slider > .unity-base-field__label { min-width: 260px; width: 260px; font-size: 24px; flex-shrink: 0; }
#ControlsPage .unity-base-text-field__input { background-color: rgb(35,35,35); color: white; border-width: 1px; border-color: rgb(150,150,150); }
#ControlsPage .unity-text-field { min-width: 80px; flex-shrink: 0; }
.settings-friend-row { margin: 6px 0 14px; padding: 12px 16px; background-color: rgb(35, 35, 35); border-top-left-radius: 30px; border-top-right-radius: 10px; border-bottom-right-radius: 30px; border-bottom-left-radius: 10px; }
.settings-friend-id { color: rgb(180, 180, 180); font-size: 19px; white-space: normal; }
.settings-friend-actions { flex-direction: row; flex-wrap: wrap; }
.settings-friend-actions > .toys-button { font-size: 21px; margin-right: 12px; }
.delete-overlay { background-color: rgba(0, 0, 0, 0.9); }
.delete-card { width: 720px; max-width: 100%; background-color: rgb(18, 18, 18); border-width: 2px; border-color: rgb(244, 171, 121); }
